<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <RootNamespace>DgiiEcf</RootNamespace>
    <AssemblyName>DgiiEcf</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>DgiiEcf</PackageId>
    <!-- Version comes from git tags (vX.Y.Z) through MinVer; untagged commits get a pre-release version. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
    <MinVerMinimumMajorMinor>1.0</MinVerMinimumMajorMinor>
    <RepositoryUrl>https://github.com/dev-fcastro/dgii-ecf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://sellernet.vercel.app/</PackageProjectUrl>
    <Authors>DgiiEcf contributors</Authors>
    <Description>Facturación electrónica (e-CF) de la DGII de República Dominicana para .NET: firma XML-DSig, autenticación, envío y consulta de e-CF, RFCE, aprobación comercial, anulación de secuencias, receptor (semilla, token y acuse de recibo), códigos QR y validación de firmas. Port del paquete Node dgii-ecf.</Description>
    <PackageTags>dgii;ecf;e-cf;facturacion-electronica;republica-dominicana;xmldsig;rfce</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeLayerAssemblies</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- The layers are separate projects but ship inside this single package. -->
  <ItemGroup>
    <ProjectReference Include="../../core/domain/domain.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../core/app/app.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../infrastructure/signing/signing.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../infrastructure/externalservices/externalservices.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- NuGet dependencies of the layers, re-declared so the package carries them. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DgiiEcf.Tests" />
  </ItemGroup>

  <Target Name="IncludeLayerAssemblies" DependsOnTargets="BuildOnlySettings;ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths-&gt;WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
    </ItemGroup>
  </Target>

</Project>
